@@ -0,0 +1,24 @@
+"""每 token 固定窗口限流。"""
+
+import time
+
+
+class FixedWindowLimiter:
+    def __init__(self, spec: str) -> None:
+        limit_text, _, window_text = spec.partition("/")
+        self.limit = int(limit_text)
+        self.window_s = float(window_text)
+        if self.limit < 1 or self.window_s <= 0:
+            raise ValueError(f"非法限流配置: {spec!r}")
+        self._state: dict[str, tuple[float, int]] = {}
+
+    def allow(self, token: str, now: float | None = None) -> bool:
+        now = time.monotonic() if now is None else now
+        window_start, count = self._state.get(token, (now, 0))
+        if now - window_start >= self.window_s:
+            window_start, count = now, 0
+        if count >= self.limit:
+            self._state[token] = (window_start, count)
+            return False
+        self._state[token] = (window_start, count + 1)
+        return True
