@@ -0,0 +1,18 @@
+"""Bearer token 鉴权。"""
+
+
+class Auth:
+    def __init__(self, tokens_csv: str) -> None:
+        self.tokens = {token.strip() for token in tokens_csv.split(",") if token.strip()}
+
+    def token_from_header(self, header) -> str | None:
+        if not header:
+            return None
+        prefix = "Bearer "
+        if not header.startswith(prefix):
+            return None
+        token = header[len(prefix):].strip()
+        return token or None
+
+    def is_valid(self, token) -> bool:
+        return token is not None and token in self.tokens
