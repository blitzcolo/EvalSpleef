+"""Bearer token 鉴权（参考解 B）。"""
+
+import hmac
+
+
+class Auth:
+    def __init__(self, tokens_csv: str) -> None:
+        self._tokens = tuple(t.strip() for t in tokens_csv.split(",") if t.strip())
+
+    def token(self, header: str | None) -> str | None:
+        if not header or not header.startswith("Bearer "):
+            return None
+        candidate = header[7:].strip()
+        for known in self._tokens:
+            if hmac.compare_digest(known, candidate):
+                return known
+        return None
