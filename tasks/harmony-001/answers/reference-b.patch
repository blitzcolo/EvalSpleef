+inline uint8_t clampByte(int v) {
+  if (v < 0) return 0;
+  if (v > 255) return 255;
+  return static_cast<uint8_t>(v);
+}
+
+std::array<uint8_t, 256> makeBrightnessLut(int32_t delta) {
+  std::array<uint8_t, 256> lut{};
+  for (int v = 0; v < 256; ++v) {
+    lut[v] = clampByte(v + static_cast<int>(delta));
+  }
+  return lut;
+}
+
+std::array<uint8_t, 256> makeContrastLut(double factor) {
+  std::array<uint8_t, 256> lut{};
+  for (int v = 0; v < 256; ++v) {
+    const double mapped = (static_cast<double>(v) - 128.0) * factor + 128.0;
+    lut[v] = clampByte(static_cast<int>(std::lround(mapped)));
+  }
+  return lut;
+}
