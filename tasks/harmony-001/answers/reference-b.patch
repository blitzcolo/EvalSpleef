+  for (int32_t y = 0; y < img.height; ++y) {
+    std::copy(flat.begin() + static_cast<size_t>(y) * img.width * 4,
+              flat.begin() + static_cast<size_t>(y + 1) * img.width * 4,
+              img.pixels + static_cast<size_t>(y) * img.stride);
+  }
