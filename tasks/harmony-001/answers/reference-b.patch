+    std::copy(srcRow, srcRow + static_cast<size_t>(img.width) * 4, flat.begin() + static_cast<size_t>(y) * img.width * 4);
+  }
+  std::vector<uint8_t> tmp(flat.size());
+  blurPass(flat, &tmp, img.width, img.height, true);
