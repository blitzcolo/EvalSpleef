+// 一趟 1D 3 邻域均值（整数四舍五入，边缘 clamp）。
+void blurPass(const std::vector<uint8_t>& src, std::vector<uint8_t>* dst,
+              int32_t w, int32_t h, bool horizontal) {
+  for (int32_t y = 0; y < h; ++y) {
+    for (int32_t x = 0; x < w; ++x) {
+      const size_t o = (static_cast<size_t>(y) * w + static_cast<size_t>(x)) * 4;
+      for (int c = 0; c < kChannels; ++c) {
+        int sum = 0;
+        for (int d = -1; d <= 1; ++d) {
+          const int sx = horizontal ? (x + d < 0 ? 0 : (x + d >= w ? w - 1 : x + d)) : x;
+          const int sy = horizontal ? y : (y + d < 0 ? 0 : (y + d >= h ? h - 1 : y + d));
+          sum += src[(static_cast<size_t>(sy) * w + static_cast<size_t>(sx)) * 4 + c];
+        }
+        (*dst)[o + c] = static_cast<uint8_t>((sum + 1) / 3);
+      }
+    }
+  }
+}
