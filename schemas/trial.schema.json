    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allowlist",
        "blocked_requests",
        "bypass_attempts"
      ],
      "description": "网络策略与留痕（docs/04 §6）。",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "docs_whitelist",
            "package_mirror",
            "full"
          ],
          "description": "实际生效的网络模式；与 sandbox.network_mode 一致（枚举与 task.schema.json network.mode 相同）。"
        },
        "allowlist": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "format": "hostname",
            "maxLength": 200
          },
          "description": "实际生效的出口白名单（host）。"
        },
        "blocked_requests": {
          "type": "integer",
          "minimum": 0,
          "description": "被代理/DNS 拦截的请求数。"
        },
        "bypass_attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "疑似绕过尝试数（IP 直连、DNS 隧道、非代理端口、TLS SNI 与 Host 不符等）；>0 进人工确认。"
        },
        "dns_log_uri": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "DNS 查询日志归档位置（含时间、查询名、结果、是否被拦截）。"
        },
        "url_log_uri": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "HTTP(S) 出口代理访问日志归档位置（含方法、URL、状态、字节数）。"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "生效网络策略文件的 sha256，用于批次间对比。"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_key_in_sandbox",
        "ssh_control_plane_only",
        "per_trial_key",
        "log_redaction"
      ],
      "description": "密钥与脑手分离证据（docs/04 §9）。",
      "properties": {
        "api_key_in_sandbox": {
          "type": "boolean",
          "description": "沙箱内是否出现模型 API key；必须为 false（true 即事故，trial 作废）。"
        },
        "ssh_control_plane_only": {
          "type": "boolean",
          "description": "SSH/ACP 是否只由控制面发起、单向进入沙箱；必须为 true。"
        },
        "per_trial_key": {
          "type": "boolean",
          "description": "本 trial 的模型调用是否使用专属短期凭证（per-trial key 或网关租约）；必须为 true。"
        },
        "key_lease_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80,
          "description": "短期凭证/网关租约 ID；首轮前为 null 视为异常。"
        },
        "log_redaction": {
          "type": "boolean",
          "description": "轨迹/日志/产物是否经过密钥与 PII 脱敏；必须为 true。"
        },
        "scanned_paths": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "description": "密钥扫描覆盖的路径（env、shell history、config、workspace）。"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hard_gates",
        "defects",
        "grades",
        "cost",
        "versions"
      ],
      "description": "判分结果（docs/02 §5.6、§6）。",
      "properties": {
        "hard_gates": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/hard_gate_result"
          },
          "description": "终判硬门槛结果（验证侧隐藏测试与观察器结论合并）。"
        },
        "defects": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "$ref": "defect.schema.json#/$defs/defect_summary_item"
          },
          "description": "终判缺陷摘要（去重后）。"
        },
        "grades": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "grade.schema.json"
          },
          "description": "grade 版本数组：重判/人工覆盖追加新版本（整文件 $ref grade.schema.json）；invalid 记录必须为空数组。"
        },
        "cost": {
          "$ref": "grade.schema.json#/$defs/cost",
          "description": "费用口径与 grade.cost 一致（agent/judge/user/total）。"
        },
        "versions": {
          "$ref": "#/$defs/versions",
          "description": "版本矩阵（批次冻结时锁定）。"
        },
        "cheat_flag": {
          "type": "boolean",
          "description": "是否作弊（派生字段：最新 grade.flags 含 cheat 即 true；权威判定仍以 grade.flags/decision 为准）。"
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_version",
        "model_version",
        "shell_version",
        "image_digest",
        "rubric_version",
        "grader_version",
        "freeze_hash"
      ],
      "description": "版本矩阵：任何一项变化都不允许与旧 trial 直接比较（docs/02 §5.1）。",
      "properties": {
        "task_version": {
          "$ref": "rubric.schema.json#/$defs/semver",
          "description": "题目版本。"
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "模型服务端版本指纹。"
        },
        "shell_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "外壳版本。"
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Agent 镜像 digest。"
        },
        "verifier_image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "验证沙箱镜像 digest（独立验证侧）。"
        },
        "rubric_version": {
          "$ref": "rubric.schema.json#/$defs/semver",
          "description": "rubric 版本。"
        },
        "grader_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "判分代码版本（reference/evalkit 版本）。"
        },
        "harbor_version": {
          "type": "string",
          "maxLength": 64,
          "description": "Harbor 版本（适配层锁版本，01-architecture §8）。"
        },
        "evalkit_version": {
          "type": "string",
          "maxLength": 64,
          "description": "evalkit 版本。"
        },
        "judge_prompt_version": {
          "type": "string",
          "maxLength": 64,
          "description": "裁判 prompt 版本。"
        },
        "freeze_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "批次冻结矩阵哈希（docs/02 §5.1）。"
        }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at"
      ],
      "description": "trial 关键时间戳（ISO-8601 UTC）。",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "记录创建时间。"
        },
        "leased_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "租约获取时间。"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Agent 开始时间（running 起点，墙钟计时起点）。"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Agent 阶段结束时间。"
        },
        "scored_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "首个 grade 生成时间。"
        },
        "destroyed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "沙箱/设备租约释放时间（teardown 完成）。"
        },
        "canary_scanned_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "金丝雀交叉扫描完成时间。"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events_uri"
      ],
      "description": "审计指针（01-architecture §5）。",
      "properties": {
        "events_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "只追加事件流（JSONL）归档位置；事件类型见 docs/02 §11。"
        },
        "isolation_bundle_uri": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "隔离证据包归档位置（isolation/ 目录）。"
        },
        "canary_report_uri": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "金丝雀扫描报告（批次级）中本 trial 部分的归档位置。"
        },
        "similarity_report_uri": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "产物相似度报告（winnowing/MOSS）归档位置。"
        },
        "trajectory_uri": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "完整轨迹归档位置（harbor view 可读）。"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_class",
        "disposition",
        "occurred_at",
        "message"
      ],
      "description": "trial 级错误（00-conventions §4.6）。",
      "properties": {
        "error_class": {
          "type": "string",
          "enum": [
            "provider",
            "model",
            "cheat",
            "isolation",
            "environment",
            "verification",
            "judge",
            "version"
          ],
          "description": "错误类别枚举（00-conventions §4.6）。"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "retry",
            "score",
            "zero",
            "manual",
            "discard"
          ],
          "description": "处置枚举（00-conventions §4.6）。"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "错误摘要（脱敏后）。"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "description": "发生时间。"
        },
        "source": {
          "type": "string",
          "maxLength": 120,
          "description": "来源组件或异常类型（如 gateway、observer、SandboxBuildFailedError）。"
        },
        "evidence_uri": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "证据归档位置。"
        }
      }
    }
  }
}
