# ==============================================================================
# EvalSpleef Single-Machine Compose Stack Environment Variables
# Copy to .env and replace placeholders before starting.
# Never commit credentials or live tokens.
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_DB=evalspleef
POSTGRES_USER=evalspleef
POSTGRES_PASSWORD=replace-with-secure-postgres-password

# Object Storage (MinIO)
MINIO_ROOT_USER=evalspleef-admin
MINIO_ROOT_PASSWORD=replace-with-secure-minio-password

# Model Gateway
# Bearer token for admin plane (key creation, budget updates, audit)
SPLEEF_GATEWAY_ADMIN_TOKEN=replace-with-secure-gateway-admin-token
# Store URL for gateway keys and usage (PostgreSQL backend)
SPLEEF_GATEWAY_STORE=postgresql://evalspleef:replace-with-secure-postgres-password@postgres:5432/evalspleef
# Public / bound ports
SPLEEF_GATEWAY_DATA_PORT=8390
SPLEEF_GATEWAY_ADMIN_PORT=8391

# Upstream Model Provider Credentials (resolved via env:// references)
NOVITA_API_KEY=replace-with-novita-api-key
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
OPENAI_API_KEY=replace-with-openai-api-key
HF_TOKEN=replace-with-huggingface-token

# Egress Proxy
SPLEEF_EGRESS_PORT=3128

# OpenTelemetry Collector
OTEL_COLLECTOR_PORT=4317
